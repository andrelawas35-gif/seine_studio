# Public browser configuration. Never put DATABASE_URL here.
# VITE_NEON_AUTH_URL is a SAME-ORIGIN path served by the auth proxy (functions/neon-auth).
# It must be "/neon-auth" so the Neon Auth session cookie stays first-party (required for
# iOS Safari / installed PWAs — a cross-site cookie there gets dropped and login loops).
# The server-side NEON_AUTH_URL secret holds the real Neon Auth URL (…/neondb/auth) that
# the proxy forwards to and that JWKS verification uses.
VITE_NEON_AUTH_URL=/neon-auth
# Switch only after both allowlisted accounts and sign-in are configured.
VITE_DATA_MODE=fixtures
