# Copy to .dev.vars for local Cloudflare Pages Functions development.
# These are SERVER secrets — never use a VITE_ prefix.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# NEON_AUTH_URL is the Neon Auth URL WITH /neondb/auth (for JWKS and auth proxy upstream).
# The client uses the same-origin proxy at /neon-auth (set VITE_NEON_AUTH_URL=/neon-auth).
NEON_AUTH_URL=https://your-neon-auth.example/neondb/auth
OWNER_EMAIL=owner@example.com
DEVELOPER_EMAIL=developer@example.com
