{
  "name": "seine-studio-operations",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "build:api": "VITE_DATA_MODE=api VITE_NEON_AUTH_URL=/neon-auth vite build",
    "deploy": "npm run build:api && wrangler pages deploy dist --project-name seine-studio --branch main --commit-dirty=true",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:backup": "node scripts/backup.mjs",
    "db:restore": "node scripts/restore.mjs",
    "db:studio": "drizzle-kit studio",
    "dev": "vite",
    "dev:full": "npm run build && wrangler pages dev dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 50",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --project functions/tsconfig.json --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
